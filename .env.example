# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
BLENDGUARD_ENV=development
BLENDGUARD_LOG_LEVEL=INFO

# --- Market data provider ---------------------------------------------------
# Resolved in backend/app/providers/. End-of-day data only.
# Development options:  bloomberg
# Production options:   a licensed or public provider
MARKET_DATA_PROVIDER=yfinance

# Data cache location. The optimizer reads from cache; providers are only
# contacted by the scheduled update job, never per request.
MARKET_DATA_CACHE_DIR=./data/cache

# --- Bloomberg (DEVELOPMENT / VALIDATION ONLY) ------------------------------
# Never enable this in production. See docs/architecture.md.
BLOOMBERG_ENABLED=false
# Optional explicit overrides; otherwise the Desktop API auto-connects.
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194

# --- Other providers --------------------------------------------------------
TIINGO_API_KEY=
FMP_API_KEY=

# --- Backend / frontend wiring ----------------------------------------------
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
