# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env
#
# Read at startup by backend/app/config/. Nothing else in the codebase reads
# environment variables directly. The file is looked up at the repository root
# first, then the working directory; override with BLENDGUARD_ENV_FILE.
#
# NAMING CONVENTION
#   BLENDGUARD_*   settings BlendGuard owns
#   BLOOMBERG_*    settings the vendor owns, so credentials map one-to-one
#   TIINGO_*       onto that vendor's documentation and can be injected
#   FMP_*          verbatim by a deployment platform's secret store
#
# Every value below is optional in development and testing. Production requires
# a real market-data provider and its credentials; startup fails with a clear
# message if they are missing.
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
# development | testing | production
BLENDGUARD_ENV=development
BLENDGUARD_LOG_LEVEL=DEBUG
# text | json. Use json in production so a log shipper can parse it.
BLENDGUARD_LOG_FORMAT=text
BLENDGUARD_DEBUG=true

# --- API -------------------------------------------------------------------
BLENDGUARD_API_HOST=127.0.0.1
BLENDGUARD_API_PORT=8000
# Comma-separated. Empty means no cross-origin access, which is the right
# default for a same-origin deployment.
BLENDGUARD_CORS_ORIGINS=http://localhost:3000

# --- Market data -----------------------------------------------------------
# stub            deterministic synthetic prices; never valid in production
# bloomberg       development/validation only, requires BLOOMBERG_ENABLED
# tiingo / fmp    set the matching API key below
BLENDGUARD_MARKET_DATA_PROVIDER=stub
BLENDGUARD_MARKET_DATA_CACHE_DIR=./data/cache
# Hours cached end-of-day data may be reused. 0 disables reuse.
# Defaults per environment: development 12, testing 0, production 24.
# BLENDGUARD_MARKET_DATA_MAX_AGE_HOURS=12

# --- Feature flags ---------------------------------------------------------
BLENDGUARD_FEATURE_SCHEDULED_DATA_UPDATES=true
# Lets allocation explanations include model internals. On in development, off
# in production.
BLENDGUARD_FEATURE_VERBOSE_EXPLANATIONS=true

# --- Bloomberg (DEVELOPMENT / VALIDATION ONLY) ------------------------------
# Must stay false in production: Bloomberg is a development data source, and
# its data must not be distributed. See docs/architecture.md.
BLOOMBERG_ENABLED=false
# Desktop API auto-connects on localhost; override only if needed.
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194
# A hosted Server API integration uses an api key plus a client id/secret pair.
# The Desktop API needs none of these, which is why they are all blank.
BLOOMBERG_API_URL=
BLOOMBERG_API_KEY=
BLOOMBERG_CLIENT_ID=
BLOOMBERG_CLIENT_SECRET=

# --- Other market-data providers -------------------------------------------
# Supply through your deployment platform's secret store in production.
TIINGO_API_KEY=
TIINGO_BASE_URL=
FMP_API_KEY=
FMP_BASE_URL=

# --- Frontend --------------------------------------------------------------
# Read by Next.js, not by the backend configuration layer.
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000